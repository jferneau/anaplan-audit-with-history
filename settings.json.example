{
    "_comment": "Complete settings reference — copy to settings.json and fill in your values. Most keys have safe defaults; the URIs only need changing for non-US or single-tenant clouds. One settings file targets one Anaplan tenant.",

    "auditEnabled": true,
    "authenticationMode": "OAuth",
    "anaplanTenantName": "Your Tenant Name",
    "database": "anaplan_audit.db",
    "lastRun": 0,
    "auditBatchSize": 1000,
    "auditRetentionYears": 0,
    "workspaceModelFilterApproach": "select",
    "workspaceModelCombos": [
        {
            "workspaceId": "8a8b8c8d8e8f",
            "modelId": "AAAABBBBCCCCDDDD"
        }
    ],
    "oauthClientId": "",
    "rotatableToken": true,
    "certPublicPath": "",
    "certPrivatePath": "",
    "certPassphrase": "",
    "uris": {
        "authServiceUri": "https://auth.anaplan.com/token/authenticate",
        "authTokenVerify": "https://auth.anaplan.com/token/validate",
        "oauthServiceUri": "https://us1a.app.anaplan.com/oauth",
        "integrationUri": "https://api.anaplan.com/2/0",
        "auditUri": "https://audit.anaplan.com/audit/api/1",
        "scimUri": "https://api.anaplan.com/scim/1/0/v2",
        "cloudWorksUri": "https://api.cloudworks.anaplan.com/2/0"
    },
    "targetAnaplanModel": {
        "workspaceId": "8a8b8c8d8e8f",
        "modelId": "AAAABBBBCCCCDDDD",
        "objects": {
            "_comment": "Prefer names — resolved to IDs at runtime, so a model copy/rebuild doesn't break this. The *Id fields still work as an override.",
            "auditFileName": "Audit Data.csv",
            "auditImportName": "Load Audit Data from Audit Data.csv",
            "lastRunFileName": "",
            "lastRunImportName": ""
        }
    },
    "modelHistory": {
        "enabled": false,
        "exportActionName": "MODEL_HISTORY_EXPORT",
        "exportTimeoutSeconds": 600,
        "retentionYears": 2,
        "anaplanProcess": "Load Model History",
        "maxConcurrentExports": 5,
        "backupBeforePurge": true,
        "maxBackupsToKeep": 7
    }
}
