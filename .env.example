# Anaplan Audit History v2 — Environment Variables
# Copy to .env and fill in values

# Basic auth credentials (replaces v1 -u/-p CLI flags)
ANAPLAN_AUDIT_BASIC_USERNAME=
ANAPLAN_AUDIT_BASIC_PASSWORD=

# OAuth client ID (alternative to settings.json)
# ANAPLAN_AUDIT_CLIENT_ID=

# Override settings.json path
# ANAPLAN_AUDIT_CONFIG_PATH=./settings.json
